{
  "name": "personai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic synthetic customer and banking ledger studio",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "personai": "node --import tsx scripts/personai.ts",
    "check": "node scripts/check.mjs",
    "format": "prettier --write src scripts tests vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src scripts tests vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
